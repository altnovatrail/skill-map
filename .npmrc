# Every version in package.json is exact, and an install keeps it so (R08 in docs/decisions.md).
save-exact=true
# No package runs code of its own while it is being installed: nothing in the tree needs to, and
# what it would run is code nobody here has read. The browser the tests run in comes with the
# toolchain stage of .devcontainer/Dockerfile instead of a package's install script (R79 spec).
ignore-scripts=true
